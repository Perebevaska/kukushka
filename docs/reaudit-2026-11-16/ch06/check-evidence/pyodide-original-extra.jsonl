{"id":"C43","key":"08b-groups-speed/speed-table","label":"author actual measured durations positive control","expected":true,"code":"import time\nimport pandas as pd\nfrom sklearn.tree import DecisionTreeClassifier\nfrom sklearn.ensemble import RandomForestClassifier\nfrom sklearn.linear_model import LogisticRegression\n\nmodels = {\n    \"дерево\": DecisionTreeClassifier(max_depth=3, random_state=0),\n    \"лес\": RandomForestClassifier(n_estimators=100, random_state=0),\n    \"логрегрессия\": LogisticRegression(max_iter=2000),\n}\nrows = []\nfor name, model in models.items():\n    t0 = time.perf_counter()\n    model.fit(X_train, y_train)\n    t1 = time.perf_counter()\n    pred = model.predict(X_test)\n    t2 = time.perf_counter()\n    rows.append({\"модель\": name, \"accuracy\": round((pred == y_test).mean(), 3),\n                 \"fit_s\": t1 - t0, \"predict_s\": t2 - t1})\nspeed = pd.DataFrame(rows).set_index(\"модель\")\nfit_ratio = speed.loc[\"лес\", \"fit_s\"] / speed.loc[\"дерево\", \"fit_s\"]\nprint(f\"лес учится в {fit_ratio:.0f} раз дольше\")\nspeed","setup_append":"","diagnostic":"","result":{"ok":true,"out":"лес учится в 21 раз дольше\n","check":{"passed":true,"msg":""},"figs":[]},"observed":true}
{"id":"C44","key":"08b-groups-speed/speed-table","label":"alternate model iteration order measured honestly","expected":true,"code":"import time\nimport pandas as pd\nfrom sklearn.tree import DecisionTreeClassifier\nfrom sklearn.ensemble import RandomForestClassifier\nfrom sklearn.linear_model import LogisticRegression\n\nmodels = {\n    \"дерево\": DecisionTreeClassifier(max_depth=3, random_state=0),\n    \"лес\": RandomForestClassifier(n_estimators=100, random_state=0),\n    \"логрегрессия\": LogisticRegression(max_iter=2000),\n}\nrows = []\nfor name, model in reversed(list(models.items())):\n    t0 = time.perf_counter()\n    model.fit(X_train, y_train)\n    t1 = time.perf_counter()\n    pred = model.predict(X_test)\n    t2 = time.perf_counter()\n    rows.append({\"модель\": name, \"accuracy\": round((pred == y_test).mean(), 3),\n                 \"fit_s\": t1 - t0, \"predict_s\": t2 - t1})\nspeed = pd.DataFrame(rows).set_index(\"модель\")\nfit_ratio = speed.loc[\"лес\", \"fit_s\"] / speed.loc[\"дерево\", \"fit_s\"]\nprint(f\"лес учится в {fit_ratio:.0f} раз дольше\")\nspeed","setup_append":"","diagnostic":"","result":{"ok":true,"out":"лес учится в 71 раз дольше\n","check":{"passed":true,"msg":""},"figs":[]},"observed":true}
{"id":"C45","key":"03-tree/leaf-size","label":"final label perturbation must not affect chosen parameter","expected":true,"code":"import pandas as pd\nfrom sklearn.model_selection import train_test_split\nfrom sklearn.tree import DecisionTreeClassifier\nd = pd.read_csv(\"deliveries.csv\", parse_dates=[\"created\"])\nok = d[d[\"actual_min\"].between(1, 299)].copy()\nok[\"hour\"] = ok[\"created\"].dt.hour\ncols = [\"distance_km\", \"items\", \"promised_min\", \"hour\"]\ny = ok[\"actual_min\"] > ok[\"promised_min\"]\nX_train, X_test, y_train, y_test = train_test_split(ok[cols], y, test_size=0.25, random_state=42)\ny_test = ~y_test\ntest_by_leaf = {}\nfor k in [1, 5, 20, 50, 100]:\n    model = DecisionTreeClassifier(min_samples_leaf=k, random_state=0).fit(X_train, y_train)\n    test_by_leaf[k] = round(model.score(X_test, y_test), 3)\nbest_leaf = max(test_by_leaf, key=test_by_leaf.get)","setup_append":"","diagnostic":"","result":{"ok":true,"out":"","check":{"passed":false,"msg":"test_by_leaf[1] = 0.271, а нужно 0.729. Дерево — только с min_samples_leaf и random_state=0, без max_depth."},"figs":[]},"observed":false}
{"id":"C46","key":"06-logistic/threshold","label":"final label perturbation must not affect chosen parameter","expected":true,"code":"import pandas as pd\nfrom sklearn.model_selection import train_test_split\nfrom sklearn.linear_model import LogisticRegression\n\nd = pd.read_csv(\"deliveries.csv\", parse_dates=[\"created\"])\nok = d[d[\"actual_min\"].between(1, 299)].copy()\nok[\"hour\"] = ok[\"created\"].dt.hour\ny = ok[\"actual_min\"] > ok[\"promised_min\"]\nX = pd.get_dummies(ok[[\"distance_km\", \"items\", \"promised_min\", \"hour\", \"courier\", \"weather\", \"shop_id\"]], dtype=int)\nX_train, X_test, y_train, y_test = train_test_split(X, y, test_size=0.25, random_state=42)\ny_test = ~y_test\np = LogisticRegression(max_iter=2000).fit(X_train, y_train).predict_proba(X_test)[:, 1]\nalarm = p >= 0.3\nalarms = round(alarm.mean(), 3)\ncaught = round(y_test[alarm].sum() / y_test.sum(), 3)\nhit = round(y_test[alarm].mean(), 3)\n\nimport numpy as np\nfor t in np.arange(0.10, 0.90, 0.05).round(2):\n    if y_test[p >= t].mean() >= 0.8:\n        t80 = t\n        caught80 = round(y_test[p >= t].sum() / y_test.sum(), 3)\n        break","setup_append":"","diagnostic":"","result":{"ok":true,"out":"","check":{"passed":false,"msg":"caught = 0.107, а нужно 0.813. Делить нужно на число всех опозданий в тесте."},"figs":[]},"observed":false}
{"id":"C47","key":"07-regression/depth","label":"final label perturbation must not affect chosen parameter","expected":true,"code":"import pandas as pd\nfrom sklearn.model_selection import train_test_split\nfrom sklearn.tree import DecisionTreeRegressor\nfrom sklearn.metrics import mean_absolute_error\n\nd = pd.read_csv(\"deliveries.csv\", parse_dates=[\"created\"])\nok = d[d[\"actual_min\"].between(1, 299)].copy()\nok[\"hour\"] = ok[\"created\"].dt.hour\ny = ok[\"actual_min\"]\nX = pd.get_dummies(ok[[\"distance_km\", \"items\", \"promised_min\", \"hour\", \"courier\", \"weather\", \"shop_id\"]], dtype=int)\nX_train, X_test, y_train, y_test = train_test_split(X, y, test_size=0.25, random_state=42)\ny_test = y_test + 1000\nmae_by_depth = {}\nfor depth in [2, 5, None]:\n    tree = DecisionTreeRegressor(max_depth=depth, random_state=0).fit(X_train, y_train)\n    mae_by_depth[depth] = round(mean_absolute_error(y_test, tree.predict(X_test)), 2)\nbest_depth = min(mae_by_depth, key=mae_by_depth.get)","setup_append":"","diagnostic":"","result":{"ok":true,"out":"","check":{"passed":false,"msg":"Для глубины 2 MAE = 999.54, а нужно 6.64."},"figs":[]},"observed":false}
